# SQL Server connection (never commit real credentials)
SQLSERVER_HOST=127.0.0.1
SQLSERVER_PORT=1433
SQLSERVER_USER=import_user
SQLSERVER_PASSWORD=change_me
SQLSERVER_DATABASE=SystemValue
SQLSERVER_ENCRYPT=disable

# Import target
IMPORT_SCHEMA=dbo
IMPORT_TABLE=Tbl_ImportPool
IMPORT_BATCH_SIZE=500
IMPORT_MAX_UPLOAD_MB=1024
IMPORT_MAX_CONCURRENT=1
HTTP_ADDR=:8080
